<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Data Driven Basics">
    <listeners>
        <listener class-name="org.uncommons.reportng.HTMLReporter"/>
        <listener class-name="org.uncommons.reportng.JUnitXMLReporter"/>
        <listener class-name="dd.example.listeners.CustomListener"/>
    </listeners>

    <test name="Bank Manager Login Test" >
        <classes>
            <class name="dd.example.testcases.BankManagerLoginTest"/>
        </classes>
    </test>
    <test name="Add Customer Test" >
        <classes>
            <class name="dd.example.testcases.AddCustomerTest"/>
        </classes>
    </test>
    <test name="Open Account Test" >
        <classes>
            <class name="dd.example.testcases.OpenAccountTest"/>
        </classes>
    </test>
</suite>